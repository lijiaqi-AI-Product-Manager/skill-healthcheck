{
  "name": "skill-healthcheck",
  "version": "1.0.2",
  "description": "Find agent skills that silently stopped working: upstream description/name changes, deleted repos, shadowed or dropped skills, and when your agent's behavior changed.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijiaqimun-coder/skill-healthcheck.git"
  },
  "homepage": "https://github.com/lijiaqimun-coder/skill-healthcheck#readme",
  "bugs": "https://github.com/lijiaqimun-coder/skill-healthcheck/issues",
  "bin": {
    "skill-healthcheck": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "docs/findings.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "npm run build && node demo/run.mjs"
  },
  "keywords": [
    "agent-skills",
    "skill",
    "SKILL.md",
    "deepseek-harness",
    "dsh",
    "claude-code",
    "codex",
    "healthcheck"
  ],
  "dependencies": {
    "semver": "^7.8.5",
    "yaml": "^2.8.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.132.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/semver": "^7.8.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
