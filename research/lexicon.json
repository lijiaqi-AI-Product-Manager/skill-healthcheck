    {
      "id": "linux-fstab",
      "regex": "/etc/fstab",
      "only_on": [
        "linux"
      ],
      "kind": "path",
      "example": "/etc/fstab",
      "explain_zh": "Linux 挂载配置，macOS 用 /etc/auto_master。"
    },
    {
      "id": "linux-lsb-release",
      "regex": "\\blsb_release\\b",
      "only_on": [
        "linux"
      ],
      "kind": "command",
      "example": "lsb_release -a",
      "explain_zh": "Linux 发行版查询命令。"
    },
    {
      "id": "linux-apt-dir",
      "regex": "/etc/apt/",
      "only_on": [
        "linux"
      ],
      "kind": "path",
      "example": "/etc/apt/sources.list",
      "explain_zh": "APT 配置目录，只有 Debian/Ubuntu 系 Linux 有。"
    },
    {
      "id": "posix-shebang",
      "regex": "#!\\s*/(usr/)?bin/(env\\s+)?(ba|z|da)?sh\\b",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "#!/usr/bin/env bash",
      "explain_zh": "shebang 依赖 Unix 路径；Windows 不按 shebang 选择解释器。"
    },
    {
      "id": "posix-shebang-python",
      "regex": "#!\\s*/(usr/)?bin/(env\\s+)?python",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "#!/usr/bin/env python3",
      "explain_zh": "Python 脚本的 shebang 只在 Unix 上生效，Windows 要靠 py 启动器。"
    },
    {
      "id": "posix-andand",
      "regex": "&&\\s*[A-Za-z./]",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "npm ci && npm test",
      "explain_zh": "&& 串命令在 Windows PowerShell 5.1 上不可用（要写 ; 或 -and）。"
    },
    {
      "id": "posix-cmd-subst",
      "regex": "\\$\\([A-Za-z_/]",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "$(date +%F)",
      "explain_zh": "命令替换；cmd.exe 不支持，PowerShell 里含义也不同。"
    },
    {
      "id": "posix-backtick-subst",
      "regex": "`[A-Za-z][^`]*`",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "`uname -a`",
      "explain_zh": "反引号做命令替换是 Unix shell 写法，PowerShell 把它当转义符。"
    },
    {
      "id": "posix-heredoc",
      "regex": "<<\\s*['\"]?[A-Za-z_]{2,}",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "<<EOF",
      "explain_zh": "heredoc 是 Unix shell 语法，PowerShell 用 here-string @\"…\"@。"
    },
    {
      "id": "posix-chmod",
      "regex": "\\bchmod\\s+[+0-7]",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "chmod +x run.sh",
      "explain_zh": "chmod 是 Unix 权限命令，Windows 没有等价的权限位。"
    },
    {
      "id": "posix-exec-bit",
      "regex": "\\bchmod\\s+(0?7[0-7]{2}|\\+x)\\b",
      "only_on": [
        "posix"
      ],
      "kind": "permission",
      "example": "chmod 755 deploy.sh",
      "explain_zh": "依赖可执行位；在 Windows/无 exec 位的文件系统上直接跑会失败。"
    },
    {
      "id": "posix-chown",
      "regex": "\\bchown\\s+[A-Za-z0-9_.:-]+",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "chown app:app data",
      "explain_zh": "chown 是 Unix 所有权命令，Windows 不支持。"
    },
    {
      "id": "posix-ln-s",
      "regex": "\\bln\\s+-s\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "ln -s target link",
      "explain_zh": "软链接；Windows 上要管理员权限或用 mklink。"
    },
    {
      "id": "posix-xargs",
      "regex": "\\bxargs\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "xargs -0 rm",
      "explain_zh": "xargs 是 Unix 工具，Windows 默认没有。"
    },
    {
      "id": "gnu-sed-inplace",
      "regex": "\\bsed\\s+-i\\b",
      "only_on": [
        "linux"
      ],
      "kind": "command",
      "example": "sed -i 's/a/b/' f.txt",
      "explain_zh": "GNU sed 的 -i 在 macOS 的 BSD sed 上会报错（要 sed -i ''）。"
    },
    {
      "id": "posix-awk",
      "regex": "\\bawk\\s+['\"]",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "awk '{print $1}'",
      "explain_zh": "awk 是 Unix 文本工具，Windows 默认没有。"
    },
    {
      "id": "posix-grep-flags",
      "regex": "\\bgrep\\s+-[A-Za-z]*[rREl][A-Za-z]*\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "grep -rn TODO .",
      "explain_zh": "grep 是 Unix 工具；Windows 自带的是 findstr。"
    },
    {
      "id": "posix-find-name",
      "regex": "\\bfind\\s+\\.\\s+-name\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "find . -name '*.log'",
      "explain_zh": "Unix find 的语法，PowerShell 用 Get-ChildItem -Filter。"
    },
    {
      "id": "posix-sudo",
      "regex": "\\bsudo\\s+\\w",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "sudo systemctl restart nginx",
      "explain_zh": "sudo 是 Unix 提权方式，Windows 需要管理员终端。"
    },
    {
      "id": "posix-usr-bin",
      "regex": "/usr/bin/",
      "only_on": [
        "posix"
      ],
      "kind": "path",
      "example": "/usr/bin/env",
      "explain_zh": "Unix 系统路径，Windows 上不存在。"
    },
    {
      "id": "posix-usr-local-bin",
      "regex": "/usr/local/bin/",
      "only_on": [
        "posix"
      ],
      "kind": "path",
      "example": "/usr/local/bin/python3",
      "explain_zh": "Unix 本地安装路径。"
    },
    {
      "id": "posix-tmp",
      "regex": "/tmp/",
      "only_on": [
        "posix"
      ],
      "kind": "path",
      "example": "/tmp/build.log",
      "explain_zh": "Unix 临时目录；Windows 用 %TEMP%。"
    },
    {
      "id": "posix-dev-null",
      "regex": "/dev/null",
      "only_on": [
        "posix"
      ],
      "kind": "path",
      "example": "command > /dev/null",
      "explain_zh": "/dev/null 是 Unix 设备，Windows 用 NUL。"
    },
    {
      "id": "posix-home-var",
      "regex": "\\$HOME\\b",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "$HOME/.config",
      "explain_zh": "$HOME 是 Unix 环境变量，Windows 用 %USERPROFILE%。"
    },
    {
      "id": "posix-export",
      "regex": "\\bexport\\s+[A-Z_][A-Z0-9_]*=",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "export PATH=\"$PWD/bin:$PATH\"",
      "explain_zh": "export 是 Unix shell 语法，cmd 用 set，PowerShell 用 $env:。"
    },
    {
      "id": "posix-source",
      "regex": "\\bsource\\s+[\\w./-]+\\.sh\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "source ./env.sh",
      "explain_zh": "source 是 bash/zsh 内建命令，PowerShell 用 . ./env.ps1。"
    },
    {
      "id": "posix-set-e",
      "regex": "\\bset\\s+-[euxo]+\\b",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "set -euo pipefail",
      "explain_zh": "shell 严格模式选项，其它平台无意义。"
    },
    {
      "id": "posix-exit-code",
      "regex": "\\$\\?",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "echo $?",
      "explain_zh": "$? 取上一条命令退出码，PowerShell 用 $LASTEXITCODE。"
    },
    {
      "id": "posix-tee",
      "regex": "\\|\\s*tee\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "npm test | tee test.log",
      "explain_zh": "tee 是 Unix 工具，Windows 默认没有。"
    },
    {
      "id": "posix-which",
      "regex": "\\bwhich\\s+(python3?|node|npm|git|docker|jq|curl)\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "which python3",
      "explain_zh": "which 是 Unix 习惯，Windows 用 where.exe。"
    },
    {
      "id": "posix-tail-f",
      "regex": "\\btail\\s+-f\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "tail -f app.log",
      "explain_zh": "tail -f 是 Unix 用法，PowerShell 用 Get-Content -Wait。"
    },
    {
      "id": "posix-dot-slash-script",
      "regex": "(^|[\\s`(])\\./[\\w.-]+\\.sh\\b",
      "only_on": [
        "posix"
      ],
      "kind": "permission",
      "example": "./deploy.sh",
      "explain_zh": "直接执行脚本依赖可执行位和 shebang，Windows 上跑不了。"
    },
    {
      "id": "posix-curl-pipe-sh",
      "regex": "\\bcurl\\s+-[A-Za-z]*[fsSL]+[^|]*\\|\\s*(ba)?sh\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "curl -fsSL https://x.test/i.sh | bash",
      "explain_zh": "管道执行远程脚本的写法，Windows PowerShell 不认。"
    },
    {
      "id": "posix-rsync",
      "regex": "\\brsync\\s+-[a-zA-Z]*[avz]",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "rsync -av src/ dst/",
      "explain_zh": "rsync 在 macOS/Linux 自带，Windows 一般没有。"
    },
    {
      "id": "posix-nohup",
      "regex": "\\bnohup\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "nohup ./run.sh &",
      "explain_zh": "nohup 是 Unix 后台运行方式。"
    },
    {
      "id": "posix-ps-aux",
      "regex": "\\bps\\s+(aux|-ef)\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "ps aux",
      "explain_zh": "ps 是 Unix 进程查看命令，Windows 用 tasklist。"
    },
    {
      "id": "posix-kill-9",
      "regex": "\\bkill\\s+-9\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "kill -9 1234",
      "explain_zh": "kill 信号是 Unix 用法，Windows 用 taskkill /F。"
    },
    {
      "id": "posix-crontab",
      "regex": "\\bcrontab\\s+-[el]\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "crontab -e",
      "explain_zh": "cron 是 Unix 定时任务，Windows 用任务计划程序。"
    },
    {
      "id": "posix-tar",
      "regex": "\\btar\\s+-?[cxzt]",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "tar -czf out.tgz dir",
      "explain_zh": "tar 是 Unix 打包工具，Windows 10+ 才有受限版本。"
    },
    {
      "id": "posix-ssh-keygen",
      "regex": "\\bssh-keygen\\b",
      "only_on": [
        "posix"
      ],
      "kind": "command",
      "example": "ssh-keygen -t ed25519",
      "explain_zh": "ssh-keygen 通常随 Unix OpenSSH 提供。"
    },
    {
      "id": "posix-var-default",
      "regex": "\\$\\{[A-Z_][A-Z0-9_]*:-",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "${PORT:-3000}",
      "explain_zh": "bash 的参数默认值展开，cmd/PowerShell 语法不同。"
    },
    {
      "id": "posix-double-bracket",
      "regex": "\\[\\[\\s+(-[a-z]|\\$\\w+)\\s+\\S+\\s*\\]\\]",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "[[ -f package.json ]]",
      "explain_zh": "bash/zsh 的 [[ ]] 条件判断，PowerShell 用 Test-Path。"
    },
    {
      "id": "posix-here-string",
      "regex": "<<<\\s*\\S",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "<<< \"$var\"",
      "explain_zh": "bash 的 here-string，只在 bash/zsh 里可用。"
    },
    {
      "id": "posix-env-prefix",
      "regex": "\\b[A-Z][A-Z0-9_]{2,}=\\S+\\s+[a-z][\\w./-]*\\s",
      "only_on": [
        "posix"
      ],
      "kind": "syntax",
      "example": "NODE_ENV=production npm start",
      "explain_zh": "命令前临时设置环境变量是 Unix 写法，PowerShell 会当成参数。"
    }
  ]
}
